[Unit]
Description=vn.py OpenCTP 7x24 gateway and local RPC service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projs/worktrees/trd_opt_vnpy/vnpy-opt-setup
EnvironmentFile=%h/.config/vnpy-opt-setup/openctp.env
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/.local/share/vnpy-opt-setup/server.log
StandardError=inherit
ExecStart=%h/.venvs/vnpy-opt-setup/bin/python -m examples.client_server.run_openctp_server
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
